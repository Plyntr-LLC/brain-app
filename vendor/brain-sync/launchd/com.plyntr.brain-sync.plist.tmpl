<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.plyntr.brain-sync</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ELECTRON_RUN_AS_NODE</key>
    <string>1</string>
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__WATCH_JS__</string>
    <string>watch</string>
    <string>__SEAT_ID__</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/brain-sync.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/brain-sync.err.log</string>
</dict>
</plist>
