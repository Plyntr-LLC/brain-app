{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": ["src/renderer/src/**/*", "src/shared/**/*.ts"],
  "exclude": ["src/shared/effort.test.ts", "src/shared/skin/hidden-kinds.test.ts", "src/shared/plyntr-package.test.ts", "src/shared/plyntr-transfer.test.ts", "src/shared/plyntr-wizard.test.ts", "src/shared/plyntr-org-copy.test.ts", "src/shared/think-run.test.ts"]
}
